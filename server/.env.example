PORT=3000
BOX_ID=box1
# Origin web untuk CORS (saat pengembangan, Vite memakai proxy sehingga tidak dipakai)
WEB_ORIGIN=http://localhost:5173
# Jumlah proxy di depan server saat deploy (mis. 1 di Render/Railway)
TRUST_PROXY=

# Rahasia HMAC hash PIN (string acak panjang). HARUS sama dengan yang ada di firmware ESP32.
PIN_HMAC_SECRET=

# Firebase Admin: path ke file service account (jangan di-commit)
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_STORAGE_BUCKET=

# MQTT. Kosong atau placeholder (xxxx) = MQTT nonaktif.
# Lokal: jalankan "npm run dev:broker" lalu isi mqtt://localhost:1883
MQTT_URL=
MQTT_USER=
MQTT_PASS=
MQTT_PREFIX=parcelbox
MQTT_CLIENT_ID=parcelbox-server
